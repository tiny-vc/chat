NODE_ENV=production
PORT=3000
SERVER_NAME=Chat
DATABASE_URL=postgresql://chat:replace-password@postgres:5432/chat?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
JOBS_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
PENDING_UPLOAD_TTL_HOURS=24
SESSION_RETENTION_DAYS=30
LOGIN_THROTTLE_RETENTION_DAYS=7
SLOW_REQUEST_MS=1000
USER_STORAGE_QUOTA_MB=1024
GROUP_JOIN_REQUEST_TTL_HOURS=168
SWAGGER_ENABLED=false
API_PUBLIC_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
JSON_BODY_LIMIT=1mb
WUKONGIM_API_URL=http://wukongim:5001
WUKONGIM_WS_URL=wss://im.example.com/ws
WUKONGIM_TCP_ADDR=im.example.com:5100
WUKONGIM_MANAGER_TOKEN=replace-with-manager-token
WUKONGIM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-with-livekit-key
LIVEKIT_API_SECRET=replace-with-livekit-secret
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=chat-files
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false
