NODE_ENV=production
PORT=3000
SERVER_NAME=Chat
CHAT_API_IMAGE=ghcr.io/tiny-vc/chat-api:sha-replace-with-commit
CHAT_MIGRATE_IMAGE=ghcr.io/tiny-vc/chat-migrate:sha-replace-with-commit
CHAT_ADMIN_IMAGE=ghcr.io/tiny-vc/chat-admin:sha-replace-with-commit
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Compose constructs DATABASE_URL from the three POSTGRES values above.
DATABASE_URL=postgresql://chat:replace-with-a-strong-database-password@postgres:5432/chat?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
JOBS_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
PENDING_UPLOAD_TTL_HOURS=24
SESSION_RETENTION_DAYS=30
LOGIN_THROTTLE_RETENTION_DAYS=7
SLOW_REQUEST_MS=1000
USER_STORAGE_QUOTA_MB=1024
GROUP_JOIN_REQUEST_TTL_HOURS=168
SWAGGER_ENABLED=false
API_PUBLIC_URL=https://chat.example.com
CORS_ALLOWED_ORIGINS=https://chat.example.com
JSON_BODY_LIMIT=1mb
WUKONGIM_API_URL=http://wukongim:5001
WUKONGIM_WS_URL=wss://im.example.com
WUKONGIM_TCP_ADDR=im.example.com:5100
WUKONGIM_MANAGER_TOKEN=replace-with-manager-token
WUKONGIM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-with-livekit-key
LIVEKIT_API_SECRET=replace-with-livekit-secret
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://chat.example.com
S3_REGION=us-east-1
S3_BUCKET=chat-files
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
