NODE_ENV=development
PORT=3000
SERVER_NAME=Chat
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
JOBS_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
PENDING_UPLOAD_TTL_HOURS=24
SESSION_RETENTION_DAYS=30
LOGIN_THROTTLE_RETENTION_DAYS=7
SLOW_REQUEST_MS=1000
USER_STORAGE_QUOTA_MB=1024
GROUP_JOIN_REQUEST_TTL_HOURS=168
SWAGGER_ENABLED=true
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=*
JSON_BODY_LIMIT=1mb
WUKONGIM_API_URL=http://localhost:5001
WUKONGIM_WS_URL=ws://localhost:5200
WUKONGIM_TCP_ADDR=localhost:5100
WUKONGIM_MANAGER_TOKEN=
WUKONGIM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-files
S3_ACCESS_KEY=chatminio
S3_SECRET_KEY=chatminiosecret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
