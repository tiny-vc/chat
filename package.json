{
  "name": "chat-server",
  "version": "0.1.0",
  "private": true,
  "description": "Chat application backend using NestJS, WuKongIM and LiveKit",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "verify:server": "sh scripts/verify-server.sh",
    "verify:livekit-production": "node scripts/verify-livekit-production.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:multi-device": "node scripts/smoke-multi-device.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "smoke:media": "node scripts/smoke-media.mjs",
    "smoke:groups": "node scripts/smoke-groups.mjs",
    "smoke:group-joins": "node scripts/smoke-group-joins.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "job:cleanup": "npm run build && node scripts/run-cleanup.mjs",
    "admin:promote": "npm run build && node --env-file=.env.example --env-file-if-exists=.env scripts/promote-admin.mjs",
    "admin:promote:docker": "docker compose run --rm --no-deps api node dist/cli/promote-admin.js",
    "backup:postgres": "sh scripts/backup-postgres.sh",
    "backup:verify": "sh scripts/verify-postgres-backup.sh",
    "backup:minio": "sh scripts/backup-minio.sh",
    "backup:minio:verify": "sh scripts/verify-minio-backup.sh",
    "backup:wukongim": "sh scripts/backup-wukongim.sh",
    "backup:wukongim:verify": "sh scripts/verify-wukongim-backup.sh",
    "openapi:generate": "npm run build && node --env-file=.env.example --env-file-if-exists=.env scripts/generate-openapi.mjs",
    "client:dart": "docker run --rm -v \"$PWD:/local\" openapitools/openapi-generator-cli:v7.24.0 generate -i /local/openapi/chat-api.json -g dart-dio -c /local/openapi/dart-client-config.yaml -o /local/clients/dart/chat_api --global-property apiTests=false,modelTests=false && node scripts/fix-dart-client.mjs && cd clients/dart/chat_api && dart pub get && dart run build_runner build",
    "client:typescript": "docker run --rm -v \"$PWD:/local\" openapitools/openapi-generator-cli:v7.24.0 generate -i /local/openapi/chat-api.json -g typescript-axios -c /local/openapi/typescript-admin-client-config.yaml -o /local/clients/typescript/admin_api --global-property apiTests=false,modelTests=false && node scripts/fix-typescript-client.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "livekit-server-sdk": "^2.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "jest": "^30.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
